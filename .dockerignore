.git
.gitignore

# Python
.venv
backend/.venv
backend/__pycache__
backend/**/*.pyc
backend/**/*.pyo

# Build artifacts
backend/build
backend/dist
backend/*.egg-info

# Tests
backend/.pytest_cache
backend/.mypy_cache
backend/.coverage
backend/htmlcov

# Env
.env
backend/.env

# IDE
.vscode
.idea

# Logs
*.log

# Frontend build artifacts — frontend/.next churns constantly under a
# running dev/prod server, which raced an `oc start-build --from-dir=.`
# tar snapshot and broke the backend's upload (2026-08-01: "no such file
# or directory" on a turbopack cache file). Originally excluded all of
# frontend/ to dodge this, but frontend/ now has its own OpenShift build
# (frontend/Dockerfile) that genuinely needs the source — only the
# actual churning/generated directories are excluded now, not the
# whole tree.
frontend/.next
frontend/node_modules
frontend/.turbo

# OS
.DS_Store
Thumbs.db

# Large files
*.pdf
