.git
.gitignore

# Python
backend/.venv
backend/__pycache__
backend/**/*.pyc
backend/**/*.pyo

# Build artifacts
backend/build
backend/dist
backend/*.egg-info

# Tests
backend/.pytest_cache
backend/.mypy_cache
backend/.coverage
backend/htmlcov

# Env
.env
backend/.env

# IDE
.vscode
.idea

# Logs
*.log

# Frontend — the backend Docker build (backend/Dockerfile) never needs any
# of this, and frontend/.next churns constantly under a running dev server,
# which raced an `oc start-build --from-dir=.` tar snapshot and broke the
# upload (2026-08-01: "no such file or directory" on a turbopack cache file).
frontend/

# OS
.DS_Store
Thumbs.db

# Large files
*.pdf
